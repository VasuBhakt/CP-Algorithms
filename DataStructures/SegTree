//Seg Tree for point update
//Source : https://github.com/VasuBhakt/CP-Algorithms/blob/main/DataStructures/SegTree
struct SegTree {
    int n; 
    vector<ll> tree;

    SegTree(int _n) {
        n = _n;
        tree.assign(2 * n, inf);
    }

    SegTree(const vector<ll> &a) {
        n = (int)a.size();
        tree.assign(2 * n, inf);
        build(a);
    }

    void recalc(int nod) {
        tree[nod] = max(tree[2 * nod], tree[2 * nod + 1]);
    }

    void build(const vector<ll> &a) {
        for (int i = 0; i < n; i++) {
            tree[n + i] = a[i];
        }
        for (int i = n - 1; i > 0; i--) {
            recalc(i);
        }
    }

    void update(int idx, ll val) {
        int nod = n + idx;
        tree[nod] = val;
        for (nod /= 2; nod > 0; nod /= 2) {
            recalc(nod);
        }
    }

    ll query(int ql, int qr) {
        ll res = -inf;
        for (ql += n, qr += n + 1; ql < qr; ql /= 2, qr /= 2) {
            if (ql & 1) res = max(res, tree[ql++]);
            if (qr & 1) res = max(res, tree[--qr]);
        }
        return res;
    }
};
